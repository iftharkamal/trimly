# PostgreSQL connection string (used by the app and drizzle-kit)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trimly

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to sign in (comma-separated, wildcards allowed).
# Production: leave empty or list exact origins (see docs/production.md).
BETTER_AUTH_TRUSTED_ORIGINS=
# Development only, when testing through `pnpm tunnel` (ngrok). Never in production:
# it trusts every site hosted on ngrok.
# BETTER_AUTH_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.app

# Integration tests only. Must be a separate database whose name ends in _test:
# the tests create it if missing, migrate it, and truncate every table.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trimly_test

# Where auth emails (verification, password reset) go.
#   console — print them in the server log (default; development only:
#             real users can't verify until a real provider is added)
#   file    — append them as JSON lines to EMAIL_FILE_PATH (used by the API tests)
EMAIL_PROVIDER=console
# EMAIL_FILE_PATH=./emails.jsonl

# Rate limits are per client IP. Set to true only when exactly one reverse proxy
# you control (Nginx, Caddy, a load balancer, ngrok) sits in front of the app and
# appends X-Forwarded-For; the last entry is then used. Without a proxy leave it
# false, or every client could choose its own address.
TRUST_PROXY=false

# `pnpm db:seed` refuses production and non-local databases. To seed a remote
# development database anyway, set both of these.
# SEED_ALLOW_REMOTE_DB=true
# SEED_OWNER_PASSWORD=

