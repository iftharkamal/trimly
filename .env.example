# PostgreSQL connection string (used by the app and drizzle-kit)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trimly

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Integration tests only. Must be a separate database whose name ends in _test:
# the tests create it if missing, migrate it, and truncate every table.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trimly_test
